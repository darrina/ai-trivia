<Window
    x:Class="AITrivia.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AITrivia.Controls"
    Title="AI Trivia">

    <Grid>
        <!-- Dark space background -->
        <Rectangle HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF1A1A2E" Offset="0"/>
                    <GradientStop Color="#FF16213E" Offset="0.5"/>
                    <GradientStop Color="#FF0F3460" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Animated particles -->
        <controls:ParticleCanvas x:Name="Particles" IsHitTestVisible="False"/>

        <!-- Main content frame -->
        <Frame x:Name="ContentFrame" Background="Transparent"/>

        <!-- Settings gear button (top-right) -->
        <Button x:Name="SettingsButton"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,12,16,0"
                Background="Transparent"
                BorderThickness="0"
                Padding="10"
                Click="SettingsButton_Click"
                ToolTipService.ToolTip="Settings">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg"
                            Background="{TemplateBinding Background}"
                            CornerRadius="20"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Bg" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#20FFFFFF"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Button.Template>
            <TextBlock Text="⚙" FontSize="18" Foreground="#80FFFFFF"/>
        </Button>

        <!-- Settings overlay -->
        <Grid x:Name="SettingsOverlay" Visibility="Collapsed">
            <Rectangle Fill="#66000000" PointerPressed="DimOverlay_PointerPressed"/>
            <controls:SettingsControl x:Name="SettingsPanel"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
        </Grid>

        <!-- About overlay -->
        <Grid x:Name="AboutOverlay" Visibility="Collapsed">
            <Rectangle Fill="#66000000" PointerPressed="DimOverlay_PointerPressed"/>
            <controls:AboutControl x:Name="AboutPanel"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
