<Page
    x:Class="AITrivia.Views.CountdownPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock x:Name="CountdownText"
                   FontSize="140" FontWeight="ExtraBlack"
                   HorizontalAlignment="Center"
                   TextAlignment="Center">
            <TextBlock.Foreground>
                <LinearGradientBrush x:Name="CountdownBrush" StartPoint="0,0" EndPoint="0,1">
                    <GradientStop x:Name="GradStop1" Color="#FF00FFFF" Offset="0"/>
                    <GradientStop x:Name="GradStop2" Color="#FF0080FF" Offset="1"/>
                </LinearGradientBrush>
            </TextBlock.Foreground>
        </TextBlock>
    </Grid>
</Page>
