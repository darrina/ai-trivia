<Page
    x:Class="AITrivia.Views.QuestionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar: Score | Streak | Q# | Quit -->
        <Grid Grid.Row="0" Margin="30,20,30,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Score -->
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="SCORE" FontSize="11" FontWeight="Bold" Foreground="#80FFFFFF"/>
                <TextBlock x:Name="ScoreText" FontSize="28" FontWeight="ExtraBlack" Foreground="White"/>
            </StackPanel>

            <!-- Streak badge -->
            <Border x:Name="StreakBadge" Grid.Column="1"
                    Background="#33FF8C00"
                    CornerRadius="20"
                    Padding="12,6"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="🔥" FontSize="16"/>
                    <TextBlock x:Name="StreakText" FontSize="18" FontWeight="ExtraBlack" Foreground="#FFFF8C00"/>
                    <TextBlock Text="STREAK" FontSize="11" FontWeight="Bold" Foreground="#B3FF8C00" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                </StackPanel>
            </Border>

            <!-- Q# / accuracy -->
            <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Right">
                <TextBlock x:Name="QuestionNumberText" FontSize="11" FontWeight="Bold" Foreground="#80FFFFFF" HorizontalAlignment="Right"/>
                <TextBlock x:Name="AccuracyText" FontSize="16" FontWeight="Bold" Foreground="#CCFFFFFF" HorizontalAlignment="Right"/>
            </StackPanel>

            <!-- Quit button -->
            <Button Grid.Column="3"
                    Background="Transparent" BorderThickness="0"
                    Padding="0" Margin="12,0,0,0"
                    Click="QuitButton_Click">
                <TextBlock Text="✕" FontSize="22" Foreground="#66FFFFFF"/>
            </Button>
        </Grid>

        <!-- Timer bar -->
        <Grid Grid.Row="1" Margin="30,0,30,20" Height="8">
            <Rectangle Fill="#1AFFFFFF" RadiusX="4" RadiusY="4"/>
            <Rectangle x:Name="TimerBar" HorizontalAlignment="Left"
                       RadiusX="4" RadiusY="4" Height="8">
                <Rectangle.Fill>
                    <SolidColorBrush x:Name="TimerBarBrush" Color="#FF34D399"/>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <!-- Question content -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Center" MaxWidth="680" Margin="40,0">

                <!-- Category + difficulty -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,0,0,4">
                    <Border x:Name="CategoryBadge" Background="#1A00CFFF" CornerRadius="12" Padding="16,6">
                        <TextBlock x:Name="CategoryText" FontSize="12" FontWeight="Bold" Foreground="#CC00CFFF"/>
                    </Border>
                    <Border x:Name="DifficultyBadge" CornerRadius="12" Padding="8,3">
                        <TextBlock x:Name="DifficultyText" FontSize="10" FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <!-- Question text -->
                <TextBlock x:Name="QuestionText"
                           FontSize="24" FontWeight="Bold"
                           Foreground="White"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,20,0,30"/>

                <!-- Answer buttons built in code-behind -->
                <StackPanel x:Name="AnswersPanel" Spacing="12"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Reveal panel -->
        <StackPanel x:Name="RevealPanel" Grid.Row="3"
                    HorizontalAlignment="Center" Spacing="12"
                    Margin="40,0,40,20"
                    Visibility="Collapsed">

            <!-- Points earned -->
            <TextBlock x:Name="PointsText"
                       HorizontalAlignment="Center"
                       FontSize="18" FontWeight="ExtraBlack"
                       Foreground="#FF34D399"
                       Visibility="Collapsed"/>

            <!-- Host message -->
            <TextBlock x:Name="HostMessageText"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       FontSize="16"
                       Foreground="#E6FFFFFF"
                       TextWrapping="Wrap"
                       MaxWidth="600"/>

            <!-- Fun fact -->
            <Border x:Name="FunFactBorder"
                    Background="#1AFBBF24"
                    CornerRadius="10"
                    Padding="20,10"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="💡" FontSize="16" VerticalAlignment="Top" Margin="0,2,0,0"/>
                    <TextBlock x:Name="FunFactText"
                               FontSize="13"
                               Foreground="#B3FFFFFF"
                               TextWrapping="Wrap"
                               MaxWidth="500"/>
                </StackPanel>
            </Border>

            <!-- Next question button -->
            <Button x:Name="NextButton"
                    HorizontalAlignment="Center"
                    Click="NextButton_Click"
                    Margin="0,8,0,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#FF533483" CornerRadius="20" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <Button.Padding>
                    <Thickness>24,10,24,10</Thickness>
                </Button.Padding>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="NEXT QUESTION" FontSize="14" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="→" FontSize="14" Foreground="White"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Page>
