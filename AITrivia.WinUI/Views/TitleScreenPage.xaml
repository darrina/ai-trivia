<Page
    x:Class="AITrivia.Views.TitleScreenPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0">

        <!-- App icon / brain emoji -->
        <TextBlock Text="🧠" FontSize="96"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,8"/>

        <!-- Title with gradient -->
        <TextBlock Text="AI TRIVIA"
                   HorizontalAlignment="Center"
                   FontSize="64" FontWeight="ExtraBlack"
                   Margin="0,0,0,8">
            <TextBlock.Foreground>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="#FF00CFFF" Offset="0"/>
                    <GradientStop Color="#FFA855F7" Offset="0.5"/>
                    <GradientStop Color="#FFEC4899" Offset="1"/>
                </LinearGradientBrush>
            </TextBlock.Foreground>
        </TextBlock>

        <!-- Subtitle -->
        <TextBlock Text="Do You Really Know AI?"
                   HorizontalAlignment="Center"
                   FontSize="22"
                   Foreground="#B3FFFFFF"
                   Margin="0,0,0,40"/>

        <!-- Start button -->
        <Button x:Name="StartButton"
                HorizontalAlignment="Center"
                Padding="40,16"
                Click="StartButton_Click"
                Margin="0,0,0,40">
            <Button.Background>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="#FFE94560" Offset="0"/>
                    <GradientStop Color="#FF533483" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="16"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="▶" FontSize="20" Foreground="White" VerticalAlignment="Center"/>
                <TextBlock Text="START GAME"
                           FontSize="20" FontWeight="Bold"
                           Foreground="White"/>
            </StackPanel>
        </Button>

        <!-- Instructions -->
        <StackPanel Spacing="8" HorizontalAlignment="Center">
            <TextBlock Text="⚡  Answer fast for maximum points"
                       HorizontalAlignment="Center"
                       FontSize="14" Foreground="#80FFFFFF"/>
            <TextBlock Text="🔥  Build streaks for combo multipliers"
                       HorizontalAlignment="Center"
                       FontSize="14" Foreground="#80FFFFFF"/>
            <TextBlock Text="🧠  Questions from your AI/ML lectures"
                       HorizontalAlignment="Center"
                       FontSize="14" Foreground="#80FFFFFF"/>
        </StackPanel>
    </StackPanel>
</Page>
