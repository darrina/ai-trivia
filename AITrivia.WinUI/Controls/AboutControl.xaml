<UserControl
    x:Class="AITrivia.Controls.AboutControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Width="360" CornerRadius="16" Background="#FA1A1A2E">
        <Border.BorderBrush><SolidColorBrush Color="#1AFFFFFF"/></Border.BorderBrush>
        <Border.BorderThickness><Thickness>1</Thickness></Border.BorderThickness>

        <StackPanel Spacing="20" Margin="0,24,0,24">

            <!-- App icon -->
            <TextBlock Text="🧠" FontSize="64" HorizontalAlignment="Center"/>

            <!-- Title -->
            <TextBlock Text="AI Trivia"
                       FontSize="24" FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>

            <!-- Version -->
            <TextBlock Text="Version 1.0"
                       FontSize="13"
                       Foreground="#80FFFFFF"
                       HorizontalAlignment="Center"/>

            <!-- Divider -->
            <Rectangle Height="1" Fill="#1AFFFFFF" Margin="30,0"/>

            <!-- Description -->
            <StackPanel Spacing="10" Margin="30,0">
                <TextBlock Text="A fast-paced trivia game covering AI &amp; Machine Learning topics."
                           TextAlignment="Center" TextWrapping="Wrap"
                           FontSize="13" Foreground="#B3FFFFFF"/>
                <TextBlock Text="Answer fast. Build streaks. Earn combos. Prove you know AI."
                           TextAlignment="Center" TextWrapping="Wrap"
                           FontSize="13" Foreground="#B3FFFFFF"/>
            </StackPanel>

            <!-- Divider -->
            <Rectangle Height="1" Fill="#1AFFFFFF" Margin="30,0"/>

            <!-- Credits -->
            <StackPanel Spacing="4" HorizontalAlignment="Center">
                <TextBlock Text="Built with WinUI 3"
                           FontSize="11" Foreground="#66FFFFFF" HorizontalAlignment="Center"/>
                <TextBlock Text="© 2026"
                           FontSize="11" Foreground="#66FFFFFF" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- OK button -->
            <Button HorizontalAlignment="Center"
                    Padding="30,8"
                    Click="OkButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#FF533483" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="OK" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
